# ==============================================================================
# EcoTwin AI - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Application Base URL
# In AI Studio preview or Cloud Run, injected automatically.
APP_URL=http://localhost:3000

# Authentication & Security
# Used for signing session JWT tokens in server/apiRouter.ts
JWT_SECRET=ecotwin_ai_jwt_secret_phase1_super_secure_key

# Storage & Database Persistence Layer
# Location of the atomic JSON persistent storage file
DATA_DIR=./data
DATABASE_NAME=ecotwin_database.json

# Gemini AI Engine Configuration
# Required for server-side AI-assisted insights and advanced predictions
GEMINI_API_KEY=MY_GEMINI_API_KEY
